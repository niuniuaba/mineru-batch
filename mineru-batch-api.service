; MinerU batch control plane: upload documents, start a conversion, watch progress,
; download the resulting Markdown. Always on, so a browser can drive it any time.
;
; The conversion itself is done by batch-convert.py, spawned as a child of this service;
; this process is only the control plane (upload, status, download).
;
; This unit carries no site-specific values. Copy batch.env.example to
; /etc/mineru-batch.env, fill in the real paths, and adjust the two ExecStart paths and
; User/Group below for the host.
;
; Install and enable at boot:
;   sudo install -m0644 mineru-batch-api.service /etc/systemd/system/
;   sudo install -m0600 batch.env.example /etc/mineru-batch.env   # then edit it
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now mineru-batch-api
;
; Logs / troubleshooting:
;   journalctl -u mineru-batch-api -f
;   curl -s localhost:8090/api/status

[Unit]
Description=MinerU batch control plane (upload, status, download)
Documentation=https://opendatalab.github.io/MinerU/
; The virtualenv and the model weights live under the service user's home, so do not
; start before the home filesystem is mounted.
RequiresMountsFor=/home
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=CHANGE_ME
Group=CHANGE_ME
WorkingDirectory=/home/wing/Apps/mineru-batch

Environment=PYTHONUNBUFFERED=1
; Site-specific values (MINERU_HOME, MINERU_BATCH_ROOT, tier, image mode, bind address,
; optional token) live here, outside the repository.
EnvironmentFile=-/etc/mineru-batch.env

ExecStart=/home/wing/Apps/mineru/bin/python /home/wing/Apps/mineru-batch/batch_api.py

; "Always ready": come back after a crash, and again after a reboot via [Install].
Restart=always
RestartSec=3

; A conversion runs as a CHILD of this service, and two mechanisms keep it alive across a
; restart of the API (KillMode=control-group, the default, would kill it):
;   1. The child inherits the run-lock descriptor, so the lock lasts as long as the
;      conversion. A restarted API sees the lock held, adopts the run, and refuses to
;      start a second one over the same output tree.
;   2. The child writes to RUN_LOG (root/run.log) instead of a pipe. A pipe would break
;      under the child when this process died; with a file the restarted API replays the
;      log and live per-document progress is restored rather than lost.
KillMode=process

; Inference is CPU-bound; keep the box responsive.
Nice=5

; --- Hardening -------------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
; /usr, /boot and /etc read-only.
ProtectSystem=full
; ProtectHome MUST stay "no": the virtualenv and the model weights live under the home
; directory. Setting it to "yes" makes the service fail to start.
ProtectHome=no

; --- Resource limits -------------------------------------------------------
; Covers the API plus its conversion child.
MemoryMax=16G

[Install]
WantedBy=multi-user.target

; ===========================================================================
; Notes
; ===========================================================================
;
; Security: there is no authentication by default. Anyone who can reach this port on the
; LAN can upload files, start a conversion, and download results. This endpoint also
; writes to disk, so it is worth knowing. Uploads are confined to the input directory by
; path normalisation (absolute paths, `..`, drive letters and symlink escapes are all
; refused) and capped per file (MINERU_BATCH_MAX_UPLOAD_BYTES, default 500 MB).
; MINERU_BATCH_TOKEN adds a bearer-token check if you want it.
;
; Storage defaults to $MINERU_HOME/batch, so the service needs no mount of its own beyond
; the home directory.
;
; Relationship to the other unit: mineru-batch.service (the headless runner) still works
; and is unaffected; it shares the same ee-in/ee-md directories. Do not start both at the
; same time — they would race on the same files. Use one or the other.
