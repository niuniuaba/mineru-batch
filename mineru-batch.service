; MinerU batch conversion: a staged chunk of documents -> mirrored Markdown tree.
;
; This is the headless runner. It is NOT enabled at boot: start it per chunk.
; The control plane (mineru-batch-api.service) is usually the better front door —
; it starts this same engine as a child and reports progress.
;
; This unit carries no site-specific values. Adjust the ExecStart paths and User/Group,
; and set MINERU_HOME / MINERU_BATCH_ROOT in /etc/mineru-batch.env.
;
; Install:
;   sudo install -m0644 mineru-batch.service /etc/systemd/system/
;   sudo systemctl daemon-reload
;
; Start a chunk (returns immediately, survives disconnect):
;   sudo systemctl start mineru-batch
;   journalctl -u mineru-batch -f          # watch progress
;   sudo systemctl stop mineru-batch       # cancel a run
;
; Exit codes: 0 = all converted, 1 = some files failed (see failures.txt), 2 = bad input.
;
; For a one-off with different paths, skip this unit entirely and use systemd-run:
;   sudo systemd-run --unit=mineru-batch-1 --uid=CHANGE_ME -p Nice=5 \
;     -p Environment=MINERU_HOME=/path/to/.mineru \
;     /path/to/venv/bin/python /path/to/mineru-batch/batch-convert.py \
;     --input /path/to/ee-in --output /path/to/ee-md --tier basic

[Unit]
Description=MinerU batch conversion (documents -> Markdown)
Documentation=https://opendatalab.github.io/MinerU/
; The virtualenv and the model weights live under the service user's home.
RequiresMountsFor=/home
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
; Type=simple, not oneshot: a chunk can run for a long time, and oneshot would either
; block `systemctl start` or hit the default 90s TimeoutStartSec.
Type=simple
User=CHANGE_ME
Group=CHANGE_ME
WorkingDirectory=/path/to/mineru-batch

; Without this, Python block-buffers stdout when it is not a tty and the journal stays
; empty until the process exits, making a long run impossible to watch.
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/mineru-batch.env

; The tier is deliberately `basic`: the small ONNX models run on CPU. A VLM tier is
; available but is markedly slower and needs a GPU with far more memory than a small
; consumer card has.
ExecStart=/path/to/venv/bin/python /path/to/mineru-batch/batch-convert.py \
    --input ${MINERU_BATCH_ROOT}/ee-in \
    --output ${MINERU_BATCH_ROOT}/ee-md \
    --tier ${MINERU_BATCH_TIER} \
    --image-mode ${MINERU_BATCH_IMAGE_MODE} \
    --report ${MINERU_BATCH_ROOT}/ee-md/run-report.json

Restart=no
; Inference is CPU-bound; keep the box responsive while a chunk runs.
Nice=5
KillMode=control-group

; --- Hardening -------------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
; /usr, /boot and /etc read-only.
ProtectSystem=full
; ProtectHome MUST stay "no": the virtualenv and the model weights live under the home
; directory. Setting it to "yes" makes the service fail to start.
ProtectHome=no

; --- Resource limits -------------------------------------------------------
MemoryMax=16G

[Install]
WantedBy=multi-user.target

; ===========================================================================
; Operating notes
; ===========================================================================
;
; Chunked workflow, driven from another machine over ssh:
;
;   1. copy a batch of documents into $MINERU_BATCH_ROOT/ee-in/
;   2. sudo systemctl start mineru-batch   (or let the control plane do it)
;   3. collect $MINERU_BATCH_ROOT/ee-md/
;   4. clear the input side for the next chunk
;
; Re-running is safe: a document whose .md already exists is skipped, so a chunk can be
; resumed or extended without redoing work. Use --force to redo a specific file.
;
; Image mode: `marker` drops figure images and leaves a positional comment, which is the
; default because the Markdown is consumed by text-only pipelines where embedded images
; are a direct cost. On image-dominant documents this also drops text baked into the
; diagrams. If the downstream consumer is multimodal, `inline` embeds each figure as a
; base64 data URI and makes the .md far larger.
;
; Output is CPU-bound and single-process: models load once per run and are reused for
; every document, so a chunk of many files is much more efficient per page than
; converting them one command at a time.
;
; Do not run this alongside mineru-batch-api: they share the input and output trees and
; would race on the same files.
