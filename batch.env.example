# Copy to /etc/mineru-batch.env (mode 0600) and edit.
#
# This file is NOT committed with real values: the repository is public. Every
# site-specific setting lives here, and the units read it via EnvironmentFile=.

# Where MinerU keeps its config, models, logs and doclib.
MINERU_HOME=/home/CHANGE_ME/.mineru

# The batch tree. Defaults to $MINERU_HOME/batch when unset; set it explicitly if the
# documents belong on another filesystem.
#MINERU_BATCH_ROOT=/home/CHANGE_ME/.mineru/batch

# Parse tier and image mode. `basic` is the CPU/ONNX tier. `marker` omits figures from
# the Markdown, which is what text-only downstream pipelines want.
MINERU_BATCH_TIER=basic
MINERU_BATCH_IMAGE_MODE=marker

# Where the control plane listens. 0.0.0.0 exposes it to the LAN.
MINERU_BATCH_HOST=0.0.0.0
MINERU_BATCH_PORT=8090

# Per-file upload cap, in bytes.
MINERU_BATCH_MAX_UPLOAD_BYTES=524288000

# Set to require "Authorization: Bearer <token>" on every /api/ call. Leaving it empty
# makes the service open to anyone who can reach the port.
MINERU_BATCH_TOKEN=
